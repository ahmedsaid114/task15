@model ForgotPasswordInputModel
@{
    ViewData["Title"] = "Forgot password";
    var requestSent = ViewData["ResetRequestSent"] is true;
}

<section class="auth-page auth-compact-page">
    <div class="auth-orbit auth-orbit-one"></div>
    <div class="auth-shell auth-single-shell">
        <section class="auth-card" aria-labelledby="auth-title">
            <a class="auth-back auth-card-back" asp-area="Customer" asp-controller="Account" asp-action="Login"><span>←</span> Back to sign in</a>
            <div class="auth-card-mark">✦</div>
            @if (requestSent)
            {
                <span class="auth-kicker">CHECK YOUR INBOX</span>
                <h2 id="auth-title">If the email matches an account…</h2>
                <p class="auth-subtitle">We’ve sent a password reset link. Check your inbox and spam folder. The link expires in 30 minutes.</p>
                <a class="auth-submit auth-submit-link" asp-area="Customer" asp-controller="Account" asp-action="Login">Back to sign in <span>↗</span></a>
            }
            else
            {
                <span class="auth-kicker">ACCOUNT RECOVERY</span>
                <h2 id="auth-title">Forgot your password?</h2>
                <p class="auth-subtitle">Enter the email address on your account and we’ll send you a reset link.</p>
                <form class="auth-form" asp-action="ForgotPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>
                    <label asp-for="Email">Email address</label>
                    <div class="auth-input-wrap"><span aria-hidden="true">✉</span><input asp-for="Email" type="email" placeholder="you@example.com" autocomplete="email" /></div>
                    <span asp-validation-for="Email" class="auth-validation"></span>
                    <button class="auth-submit" type="submit">Send reset link <span>↗</span></button>
                </form>
                <p class="auth-switch">Remembered it? <a asp-area="Customer" asp-controller="Account" asp-action="Login">Sign in</a></p>
            }
        </section>
    </div>
</section>
