@{
    ViewData["Title"] = "Reset link expired";
}

<section class="auth-page auth-compact-page">
    <div class="auth-orbit auth-orbit-one"></div>
    <div class="auth-shell auth-single-shell">
        <section class="auth-card">
            <div class="auth-card-mark">✦</div>
            <span class="auth-kicker">LINK EXPIRED</span>
            <h2>This reset link can’t be used.</h2>
            <p class="auth-subtitle">Reset links expire after 30 minutes and work only once. Request a fresh link to continue.</p>
            <a class="auth-submit auth-submit-link" asp-area="Customer" asp-controller="Account" asp-action="ForgotPassword">Request another link <span>↗</span></a>
        </section>
    </div>
</section>
